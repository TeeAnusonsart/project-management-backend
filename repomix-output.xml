}

func NewRoomUsecase(r domain.RoomRepository) RoomUsecase {
	return &roomUsecase{roomRepo: r}
}

func (u *roomUsecase) CreateRoom(name string) error {
	room := &domain.Room{Name: name}
	return u.roomRepo.Create(room)
